# Firebase web app config (Firebase console > Project settings > Your apps).
# Firebase is used only for Authentication; all data is stored in MongoDB via the API.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Base URL of the Express API. Leave empty in development: Vite proxies /api to localhost:5000.
VITE_API_URL=
