PORT=5000

# Frontend origin(s) allowed by CORS, comma-separated.
CLIENT_URL=http://localhost:8443

# MongoDB Atlas connection string. All application data is stored here.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/barterman?retryWrites=true&w=majority

# Optional: DNS servers for the mongodb+srv lookup, if you see "querySrv ECONNREFUSED".
# Example: 8.8.8.8,1.1.1.1
DNS_SERVERS=

# Firebase project used ONLY to verify sign-in tokens.
FIREBASE_PROJECT_ID=bartermanfsd

# Optional: path to a Firebase service-account JSON. Not needed just to verify tokens.
# Never commit this file.
FIREBASE_SERVICE_ACCOUNT_PATH=

# Cloudinary (listing images). Find these in Cloudinary console > Settings > API Keys.
# The API secret must stay server-side; never put it in frontend/.env.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# College email domains allowed to sign in, comma-separated (subdomains are included).
# Example: pes.edu,christuniversity.in. Leave empty to allow any verified email.
ALLOWED_EMAIL_DOMAINS=
